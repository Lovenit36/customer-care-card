# Copy to .env and enter your key. The server loads this file itself.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set to the REAL, HTTPS public URL when deployed. QR cards use this.
PUBLIC_BASE_URL=http://localhost:8000
# Optional: persistence location (mount a durable volume in production)
DATA_DIR=./storage
PORT=8000
# Set to 1 behind a real HTTPS proxy on the public internet
COOKIE_SECURE=0
# For a public test, use 1 only after HTTPS is working.
